#!name=AliDNS HTTPDNS 用量面板
#!desc=Surge 面板：阿里云 HTTPDNS 当月用量（HTTP=1x，HTTPS/DoH/DoT=5x），含进度条、日均、月末预估与超额预警；支持多账号汇总与单账号额度。凭据仅本地签名，直发阿里云。
#!author=Minis · DeepSeek 重构版
#!homepage=https://github.com/BigHeadTiger/surge.sgmodule
#!system=ios
#!tags=panel,aliyun,httpdns,usage
#!icon=cloud.fill

# 使用：编辑下方 [Script] 行 argument，填 name1=备注&id1=AccessKeyId&secret1=Secret（多账号顺延 name2/id2/secret2；密钥含特殊字符请 URL 编码）
# 可选参数：quota=10000000（默认额度）quotaN=单账号额度 https-factor=5 udp-factor=0 timeout=15 debug=1
# 改后：Surge → 模块 → 重新加载本模块，再点面板刷新

[Panel]
AliDNSUsage = title="阿里 HTTPDNS",script-name=AliDNSUsage,update-interval=1800

[Script]
AliDNSUsage = type=generic,script-path=https://raw.githubusercontent.com/BigHeadTiger/surge.sgmodule/main/alidns-usage.js,timeout=45,argument=quota=10000000&name1=账号备注&id1=你的AccessKeyID&secret1=你的AccessKeySecret