#!name=AliDNS HTTPDNS 用量面板
#!desc=Surge 面板：阿里云 HTTPDNS 当月用量（HTTP=1x，HTTPS/DoH/DoT=5x），显示日均消耗与已用用量，超额自动变色；凭据仅本地签名，直发阿里云。
#!author=Minis · DeepSeek 重构版
#!homepage=https://github.com/BigHeadTiger/surge.sgmodule
#!system=ios
#!tags=panel,aliyun,httpdns,usage
#!icon=cloud.fill
#!arguments=quota:10000000,name1:主账号,id1,secret1
#!arguments-desc=填写阿里云 AccessKey：id1=AccessKeyID，secret1=AccessKeySecret，仅保存在本设备。密钥含特殊字符请 URL 编码（+→%2B /→%2F =→%3D）。多账号请在模块 [Script] 行 argument 中追加 name2=备注&id2=…&secret2=…。

[Panel]
AliDNSUsage = title="阿里 HTTPDNS",script-name=AliDNSUsage,update-interval=1800

[Script]
AliDNSUsage = type=generic,script-path=https://raw.githubusercontent.com/BigHeadTiger/surge.sgmodule/main/alidns-usage.js,timeout=45,argument=quota={{{quota}}}&name1={{{name1}}}&id1={{{id1}}}&secret1={{{secret1}}}