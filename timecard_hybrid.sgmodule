#!name=节假日信息（自建混合版）
#!desc=显示农历、干支、生肖与最近节假日倒计时。
#!author=Minis
#!system=ios
#!tags=panel,holiday,lunar
#!icon=calendar
#!version=5.8
#!arguments=LogLevel:INFO
#!arguments-desc=日志等级（写入脚本详情→日志）：OFF 静默 / ERROR / WARN / INFO 运行概要（默认）/ DEBUG / ALL

[Panel]
Timecard-Hybrid = title="节假日信息",script-name=Timecard-Hybrid,update-interval=21600

[Script]
Timecard-Hybrid = type=generic,timeout=15,script-path=https://raw.githubusercontent.com/BigHeadTiger/surge.sgmodule/refs/heads/main/timecard_hybrid.js,argument=LogLevel={{{LogLevel}}}