#!name=Meituan Redirect
#!desc=Redirect Meituan domains to dreport domains

[General]
# > 真实 IP 映射（解决 Fake-IP 模式下部分服务不兼容的问题）
always-real-ip = *.meituan.net 

[Host]
al-log.d.meituan.net = al-log.dreport.meituan.net, server:system
route-stats.d.meituan.net = route-stats.dreport.meituan.net, server:system
metrics-picture.d.meituan.net = metrics-picture.dreport.meituan.net, server:system
maplocatesdksnapshot.d.meituan.net = maplocatesdksnapshot.dreport.meituan.net, server:system