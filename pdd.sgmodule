#!name=拼多多
#!desc=移除广告，沉浸购物
#!author=树先生
#!requirement=CORE_VERSION>=20

[MITM]
hostname = %APPEND% api.pinduoduo.com

[URL Rewrite]

# 开屏广告
^https:\/\/api\.pinduoduo\.com\/api\/cappuccino\/splash _ reject

# 拼多多首页搜索框关键词
^https:\/\/api\.pinduoduo\.com\/search_hotquery _ reject

# 拼多多聊天页和我的页商品推荐
^https:\/\/api\.pinduoduo\.com\/api\/alexa\/goods\/back_up _ reject
^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/new_chat_group _ reject

# 拼多多我的页底部商品推荐
^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/personal _ reject

# 拼多多待收货页商品推荐
^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/my_order_group _ reject

# 拼多多我的页面商品收藏推荐
^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/likes _ reject

# 拼多多店铺收藏页推荐
^https:\/\/api\.pinduoduo\.com\/api\/social\/mall\/follow\/hot\/recommend _ reject

# 红包优惠弹窗
^https:\/\/api\.pinduoduo\.com\/api\/leporis\/notification\/clear_tab_red_dot _ reject
^https:\/\/api\.pinduoduo\.com\/api\/aquarius\/hungary\/global\/homepage\? _ reject

# 聊天页顶部 0 元下单推广入口
^https:\/\/api\.pinduoduo\.com\/api\/zaire_biz\/chat\/resource\/get_list_data _ reject

# 订单页面顶部优惠券横幅推广及倒计时
^https:\/\/api\.pinduoduo\.com\/api\/aristotle\/query_order_list_tabs_element _ reject


[Body Rewrite]

# 我的页面顶部红包入口、横幅广告、现金大转盘等
http-response-jq ^https:\/\/api\.pinduoduo\.com\/api\/philo\/personal\/hub$ 'del(.personal_banner, .personal_center_style_v2_vo.third_personal_icons_v2) | if .monthly_card_entrance then .monthly_card_entrance.display = false else . end'

# 首页底部优惠券推荐横条
http-response-jq ^https:\/\/api\.pinduoduo\.com\/api\/growth\/nagato\/app\/index\/gather$ 'del(.newer_index_banner.data)'

# 物流页面横幅广告
http-response-jq ^https:\/\/api\.pinduoduo\.com\/order\/\d+-\d+\/shipping$ 'del(.shipping.banner_above_recommend)'


[Script]

# 拼多多首页简化
pdd-home = type=http-response,pattern=^https:\/\/api\.pinduoduo\.com\/api\/alexa\/homepage\/hub$,requires-body=true,script-path=https://raw.githubusercontent.com/ishowshu/qx/refs/heads/main/script/pdd.js,max-size=1048576