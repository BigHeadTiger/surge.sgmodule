#!name = 拼多多
#!desc = 移除广告，沉浸购物
#!author = 树先生

[URL Rewrite]
^https://api.pinduoduo.com/api/cappuccino/splash$ reject-json {}
^https://api.pinduoduo.com/search_hotquery$ reject-json {}
^https://api.pinduoduo.com/api/alexa/goods/back_up$ reject-json {}
^https://api.pinduoduo.com/api/caterham/v3/query/new_chat_group$ reject-json {}
^https://api.pinduoduo.com/api/caterham/v3/query/personal$ reject-json {}
^https://api.pinduoduo.com/api/caterham/v3/query/my_order_group$ reject-json {}
^https://api.pinduoduo.com/api/caterham/v3/query/likes$ reject-json {}
^https://api.pinduoduo.com/api/social/mall/follow/hot/recommend$ reject-json {}
^https://api.pinduoduo.com/api/leporis/notification/clear_tab_red_dot$ reject-json {}
^https://api.pinduoduo.com/api/aquarius/hungary/global/homepage\?$ reject-json {}
^https://api.pinduoduo.com/api/zaire_biz/chat/resource/get_list_data$ reject-json {}
^https://api.pinduoduo.com/api/aristotle/query_order_list_tabs_element$ reject-json {}

[Script]
pdd-modify = type=script-response-body, pattern=^https://api.pinduoduo.com/(api/philo/personal/hub|api/growth/nagato/app/index/gather|order/\d+-\d+/shipping)$, script=function(){var body=$response.body;try{var obj=JSON.parse(body);if($request.url.includes('/api/philo/personal/hub')){delete obj.personal_banner;if(obj.personal_center_style_v2_vo)delete obj.personal_center_style_v2_vo.third_personal_icons_v2;if(obj.monthly_card_entrance)obj.monthly_card_entrance.display=false;}else if($request.url.includes('/api/growth/nagato/app/index/gather')){if(obj.newer_index_banner)delete obj.newer_index_banner.data;}else if($request.url.match(/\/order\/\d+-\d+\/shipping/)){if(obj.shipping)delete obj.shipping.banner_above_recommend;}$done({body:JSON.stringify(obj)});}catch(e){$done({body:body});}}

pdd-homepage = type=script-response-body, pattern=^https://api.pinduoduo.com/api/alexa/homepage/hub$, script=https://github.com/ishowshu/qx/raw/refs/heads/main/script/pdd.js

[MITM]
hostname = api.pinduoduo.com