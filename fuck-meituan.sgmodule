#!name=Meituan Redirec
#!desc=VPN环境下，错误解析修复。

[URL Rewrite]
^http(s)?:\/\/(.*).d.meituan.net http$1://$2.dreport.meituan.net 302

[Host]
ntp.nasa.gov = time.nist.gov

[MITM]
hostname = %APPEND% al-log.d.meituan.net,route-stats.d.meituan.net,metrics-picture.d.meituan.net,maplocatesdksnapshot.d.meituan.net