#!name=美团 代理检测绕过
#!desc=绕过美团 app 的代理/VPN 检测：真实 DNS(always-real-ip)、直连。需在 Surge 内开启。

[General]
always-real-ip = %APPEND% meituan.com, *.meituan.com, meituan.net, *.meituan.net
skip-proxy = %APPEND% meituan.com, *.meituan.com, meituan.net, *.meituan.net

[Rule]
DOMAIN-SUFFIX,meituan.com,DIRECT
DOMAIN-SUFFIX,meituan.net,DIRECT
